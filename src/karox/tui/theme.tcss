/* KaroX terminal client -- a coding-agent CLI session in the v5 palette.
 *
 * Warm near-black ground, one gold accent for position and action, green/red
 * reserved for outcomes. The transcript is plain lines like a CLI session:
 * the welcome box and the composer are the only frames, every turn and tool
 * line is separated by one blank row, and results hang under their call
 * behind a dim elbow.
 */

Screen {
    background: #0e0c08;
    color: #e5e5e5;
}

#chat {
    height: 1fr;
    padding: 1 2 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: #4a4338;
    scrollbar-color-hover: #6f6656;
    scrollbar-background: #0e0c08;
}

/* ------------------------------------------------------------ transcript */

.welcome {
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 2 0 1;
    border: round #c6a56b;
}

.user-message {
    width: 100%;
    margin: 1 0 0 0;
    color: #8a7e6a;
}

.command-echo {
    width: 100%;
    margin: 1 0 0 0;
    color: #8a7e6a;
}

.assistant-message {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    padding: 0;
}

.thinking-line {
    width: 100%;
    height: auto;
    padding: 0 0 0 2;
}

.answer-row {
    width: 100%;
    height: auto;
}

.answer-bullet {
    width: 2;
    height: 1;
    color: #e5e5e5;
}

.answer-body {
    width: 1fr;
    height: auto;
}

.live-answer {
    color: #e5e5e5;
}

.final-answer {
    color: #e5e5e5;
    margin: 0;
    padding: 0;
    background: #0e0c08;
}

.tool-card {
    width: 100%;
    margin: 1 0 0 0;
    padding: 0;
}

.tool-card:hover {
    background: #16130d;
}

/* A notice hangs under the line it answers, like a command's output. */
.notice {
    width: 100%;
    margin: 0 0 0 2;
}

.notice.run-result {
    margin: 1 0 0 0;
}

.text-block {
    width: 100%;
    margin: 0 0 0 2;
}

/* ---------------------------------------------------- the working line */

#working {
    height: auto;
    margin: 1 1 0 1;
}

#working-row {
    height: 1;
}

#spinner {
    width: 10;
    height: 1;
    min-height: 1;
    color: #d4b676;
    background: #0e0c08;
    content-align: left middle;
}

#working-text {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#working-sub {
    height: auto;
    padding: 0 0 0 2;
}

/* The inline list: the slash palette and every picker open here, right above
   the composer, and close back to nothing. */
#menu {
    height: auto;
    margin: 0 2;
    padding: 0 1;
    background: #15120c;
}

#menu-title {
    height: 1;
    color: #d4b676;
    text-style: bold;
}

#menu-options {
    height: auto;
    max-height: 10;
    padding: 0;
    border: none;
    background: #15120c;
    scrollbar-size-vertical: 1;
    scrollbar-color: #4a4338;
    scrollbar-background: #15120c;
}

#menu-options:focus {
    border: none;
}

#menu-options > .option-list--option-highlighted {
    background: #2a2418;
    color: #f0e6cf;
}

#menu-options > .option-list--option-hover {
    background: #211c13;
}

#menu-hint {
    height: 1;
    color: #6f6656;
}

/* ------------------------------------------------------------- composer */

#composer-box {
    height: auto;
    margin: 1 1 0 1;
    padding: 0 1;
    border: round #4a4338;
    background: #0e0c08;
}

#composer-box:focus-within {
    border: round #8a7e6a;
}

#composer-prompt {
    width: 2;
    height: 1;
    color: #8a7e6a;
}

#composer {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 10;
    margin: 0;
    padding: 0;
    background: #0e0c08;
    color: #e5e5e5;
    border: none;
}

#composer:focus {
    border: none;
}

#composer .text-area--placeholder {
    color: #6f6656;
}

#composer .text-area--cursor-line {
    background: #0e0c08;
}

#prompt-label {
    height: 1;
    margin: 1 3 0 3;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#secret {
    height: 3;
    margin: 0 1;
    padding: 0 1;
    background: #0e0c08;
    border: round #d4b676;
}

#secret:focus {
    background: #0e0c08;
    background-tint: #0e0c08 0%;
}

/* --------------------------------------------------------------- footer */

#status {
    height: 1;
    padding: 0 3;
}

#status #hint {
    width: auto;
    height: 1;
    text-wrap: nowrap;
    margin: 0 2 0 0;
}

#status #facts {
    width: 1fr;
    height: 1;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#shortcuts {
    height: auto;
    padding: 0 3;
    color: #8a7e6a;
}

/* ------------------------------------------------------------------- forms */

.modal {
    width: 84;
    max-width: 94%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: #1a1712;
    border: round #c6a56b;
}

.modal-title {
    color: #d4b676;
    text-style: bold;
    margin-bottom: 1;
}

.modal-hint {
    color: #8a7e6a;
    margin-top: 1;
}

.modal-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

.modal-buttons Button {
    margin-left: 2;
}

.field-label {
    color: #8a7e6a;
    margin-top: 1;
}

.form-error {
    color: #e0a3a3;
    margin-top: 1;
}

.form-modal Input {
    background: #1a1712;
    border: round #4a4338;
}

.form-modal Input:focus {
    border: round #d4b676;
}

.form-modal Select {
    width: 100%;
}

SelectCurrent {
    background: #1a1712;
    border: round #4a4338;
}

SelectCurrent:focus {
    border: round #d4b676;
}

SelectOverlay {
    background: #1a1712;
    border: round #4a4338;
}

Button {
    background: #2a241a;
    color: #e5e5e5;
    border: round #4a4338;
    min-width: 8;
}

Button:hover {
    background: #332b1d;
}

Button.-primary {
    background: #d4b676;
    color: #0e0c08;
    text-style: bold;
}

Button.-primary:hover {
    background: #e0c98c;
}

Button:focus {
    border: round #d4b676;
}

/* Markdown ends every block with a blank row; the last one must not, or an
   answer stands two rows apart from whatever follows it. */
.final-answer > *:last-child {
    margin-bottom: 0;
}
