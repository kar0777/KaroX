/* KaroX terminal client -- v5 rc4 palette.
 *
 * Warm near-black ground, one gold accent for position and action, green/red
 * reserved for outcomes. The transcript is plain lines like a CLI session: no
 * box is drawn around prose, so the only frames on screen are the composer
 * and the two forms.
 */

Screen {
    background: #0e0c08;
    color: #e5e5e5;
}

#chat {
    height: 1fr;
    padding: 1 2 0 2;
    scrollbar-size-vertical: 1;
    scrollbar-color: #4a4338;
    scrollbar-color-hover: #6f6656;
    scrollbar-background: #0e0c08;
}

.welcome {
    width: 100%;
    margin: 0 0 1 0;
}

.user-message {
    width: 100%;
    margin: 1 0 0 0;
}

.command-echo {
    width: 100%;
    margin: 1 0 0 0;
    color: #8a7e6a;
}

.assistant-message {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0 0 0 2;
}

.reasoning-line {
    color: #6f6656;
}

.live-answer {
    color: #e5e5e5;
}

.final-answer {
    color: #e5e5e5;
    margin: 0;
    padding: 0;
    background: #0e0c08;
}

.tool-card {
    width: 100%;
    margin: 0 0 0 2;
    padding: 0;
}

.tool-card:hover {
    background: #16130d;
}

.notice {
    width: 100%;
    margin: 0;
}

.text-block {
    width: 100%;
    margin: 0 0 0 2;
}

#activity {
    height: 1;
    padding: 0 2;
}

#activity LoadingIndicator {
    width: 3;
    height: 1;
    color: #d4b676;
    background: #0e0c08;
    margin: 0 1 0 0;
}

#activity #activity-line {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* The inline list: the slash palette and every picker open here, right above
   the composer, and close back to nothing. */
#menu {
    height: auto;
    margin: 0 2;
    padding: 0 1;
    background: #15120c;
}

#menu-title {
    height: 1;
    color: #d4b676;
    text-style: bold;
}

#menu-options {
    height: auto;
    max-height: 10;
    padding: 0;
    border: none;
    background: #15120c;
    scrollbar-size-vertical: 1;
    scrollbar-color: #4a4338;
    scrollbar-background: #15120c;
}

#menu-options:focus {
    border: none;
}

#menu-options > .option-list--option-highlighted {
    background: #2a2418;
    color: #f0e6cf;
}

#menu-options > .option-list--option-hover {
    background: #211c13;
}

#menu-hint {
    height: 1;
    color: #6f6656;
}

#composer {
    height: auto;
    min-height: 3;
    max-height: 10;
    margin: 0 2;
    padding: 0 1;
    background: #0e0c08;
    color: #e5e5e5;
    border: round #4a4338;
}

#composer:focus {
    border: round #8a7e6a;
}

#composer .text-area--placeholder {
    color: #6f6656;
}

#composer .text-area--cursor-line {
    background: #0e0c08;
}

#prompt-label {
    height: 1;
    margin: 0 3;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#secret {
    height: 3;
    margin: 0 2;
    padding: 0 1;
    background: #0e0c08;
    border: round #d4b676;
}

#secret:focus {
    background: #0e0c08;
    background-tint: #0e0c08 0%;
}

#status {
    height: 1;
    padding: 0 3;
}

#status #facts {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#status #state {
    width: auto;
    height: 1;
    margin: 0 0 0 2;
}

/* ------------------------------------------------------------------- forms */

.modal {
    width: 84;
    max-width: 94%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: #1a1712;
    border: round #c6a56b;
}

.modal-title {
    color: #d4b676;
    text-style: bold;
    margin-bottom: 1;
}

.modal-hint {
    color: #8a7e6a;
    margin-top: 1;
}

.modal-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

.modal-buttons Button {
    margin-left: 2;
}

.field-label {
    color: #8a7e6a;
    margin-top: 1;
}

.form-error {
    color: #e0a3a3;
    margin-top: 1;
}

.form-modal Input {
    background: #1a1712;
    border: round #4a4338;
}

.form-modal Input:focus {
    border: round #d4b676;
}

.form-modal Select {
    width: 100%;
}

SelectCurrent {
    background: #1a1712;
    border: round #4a4338;
}

SelectCurrent:focus {
    border: round #d4b676;
}

SelectOverlay {
    background: #1a1712;
    border: round #4a4338;
}

Button {
    background: #2a241a;
    color: #e5e5e5;
    border: round #4a4338;
    min-width: 8;
}

Button:hover {
    background: #332b1d;
}

Button.-primary {
    background: #d4b676;
    color: #0e0c08;
    text-style: bold;
}

Button.-primary:hover {
    background: #e0c98c;
}

Button:focus {
    border: round #d4b676;
}
