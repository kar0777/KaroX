/* KaroX compact client -- v5 rc4 palette.
 *
 * Warm near-black ground, one gold accent for position and action, green/red
 * reserved for outcomes. No box is drawn around ordinary prose, so a border
 * always means "this needs attention".
 */

Screen {
    background: #0e0c08;
    color: #e5e5e5;
}

#header {
    height: 1;
    padding: 0 2;
    background: #1a1712;
    color: #e5e5e5;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#chat {
    height: 1fr;
    padding: 1 2 0 2;
    scrollbar-color: #4a4338;
    scrollbar-background: #0e0c08;
}

.welcome {
    width: 100%;
    margin: 0 0 1 0;
    padding: 1 2;
    background: #15120c;
    border: round #4a4338;
}

.user-message {
    width: 100%;
    margin: 1 0 0 0;
    padding: 0;
}

.assistant-message {
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 0 0 2;
    border-left: thick #4a4338;
}

.reasoning-line {
    color: #8a7e6a;
    margin-bottom: 0;
}

.live-answer {
    color: #e5e5e5;
}

.final-answer {
    color: #e5e5e5;
    margin: 0;
}

.tool-card {
    width: 100%;
    margin: 0 0 0 2;
    padding: 0 1;
    background: #16130d;
    border-left: thick #4a4338;
}

.tool-card:hover {
    background: #1d1810;
}

/* One quiet colour per kind of work, so a scrolling log can be read at a
   glance: gold mutates, green proves, amber leaves the process. */
.tool-read { border-left: thick #8a7e6a; }
.tool-edit { border-left: thick #d4b676; }
.tool-test { border-left: thick #8aab7e; }
.tool-mcp { border-left: thick #c6a56b; }
.tool-skill { border-left: thick #d4b676; }
.tool-plan { border-left: thick #8a7e6a; }
.tool-web { border-left: thick #c6a56b; }
.tool-inspect { border-left: thick #8a7e6a; }
.tool-subagent { border-left: thick #c6a56b; }
.tool-other { border-left: thick #4a4338; }

.notice {
    width: 100%;
    margin: 1 0;
    padding: 0 1;
    border: round #4a4338;
    background: #15120c;
}

.notice-success {
    border: round #3f4d38;
}

.notice-warning {
    border: round #584a26;
}

.notice-error {
    border: round #5c3a3a;
}

#activity {
    height: 1;
    padding: 0 2;
    background: #0e0c08;
}

#activity LoadingIndicator {
    width: 3;
    height: 1;
    color: #d4b676;
    background: #0e0c08;
    margin: 0 1 0 0;
}

#activity #activity-line {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#composer {
    height: 3;
    margin: 0 2;
    padding: 0 1;
    background: #1a1712;
    color: #e5e5e5;
    border: round #4a4338;
}

#composer:hover {
    border: round #c6a56b;
}

#composer:focus {
    border: round #d4b676;
}

#composer .text-area--placeholder {
    color: #8a7e6a;
}

#status {
    height: 1;
    padding: 0 2;
    background: #1a1712;
}

#status #hint {
    width: 1fr;
    content-align: left middle;
}

#status #state {
    width: auto;
    content-align: right middle;
}

/* ------------------------------------------------------------------ modals */

.modal {
    width: 84;
    max-width: 94%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: #1a1712;
    border: round #c6a56b;
}

.modal-title {
    color: #d4b676;
    text-style: bold;
    margin-bottom: 1;
}

.modal-hint {
    color: #8a7e6a;
    margin-top: 1;
}

.modal-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

.modal-buttons Button {
    margin-left: 2;
}

.field-label {
    color: #8a7e6a;
    margin-top: 1;
}

.form-error {
    color: #e0a3a3;
    margin-top: 1;
}

.form-modal Input {
    background: #1a1712;
    border: round #4a4338;
}

.form-modal Input:focus {
    border: round #d4b676;
}

.form-modal Select {
    width: 100%;
}

.help-modal {
    width: 86;
}

.help-scroll {
    height: auto;
    max-height: 24;
}

.confirm-modal {
    width: 64;
}

.mcp-modal {
    width: 100;
    max-width: 96%;
}

.session-modal {
    width: 96;
    max-width: 96%;
}

.session-scroll {
    height: auto;
    max-height: 26;
}

.mcp-modal OptionList {
    height: auto;
    max-height: 20;
    background: #1a1712;
    border: round #4a4338;
}

.mcp-modal OptionList:focus {
    border: round #d4b676;
}

OptionList {
    background: #1a1712;
    border: round #4a4338;
}

OptionList:focus {
    border: round #d4b676;
}

OptionList > .option-list--option-highlighted {
    background: #2a2418;
    color: #f0e6cf;
}

OptionList > .option-list--option-hover {
    background: #241e14;
}

SelectCurrent {
    background: #1a1712;
    border: round #4a4338;
}

SelectCurrent:focus {
    border: round #d4b676;
}

Button {
    background: #2a241a;
    color: #e5e5e5;
    border: round #4a4338;
    min-width: 8;
}

Button:hover {
    background: #332b1d;
}

Button.-primary {
    background: #d4b676;
    color: #0e0c08;
    text-style: bold;
}

Button.-primary:hover {
    background: #e0c98c;
}

Button:focus {
    border: round #d4b676;
}
